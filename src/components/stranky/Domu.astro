---
// Homepage (front-page.php of the child theme, new look): hero with search, the five sections as photo tiles,
// popular stays, the most popular offers, cities, why us, blog.
import Base from '../../layouts/Base.astro';
import Mrizka from '../Mrizka.astro';
import { cislo, datum, decode, excerpt } from '../../lib/format';
import { card } from '../../lib/img';
import type { HomeView } from '../../lib/views';
interface Props { v: HomeView }
const { v } = Astro.props;
type Tile = HomeView['sections'][number];
const tileImg = (x: Tile) => card(x.image, 280);
---
<Base meta={v.meta} pageType="home" searchAction>
	<section class="hero">
		<div class="w hero__in">
			<div>
				<h1>Zážitky, pobyty a dovolená <em>se slevou</em></h1>
				<p>Prohledáme nabídky ověřených partnerů a ukážeme vám ty nejvýhodnější — wellness, romantiku, glamping, gastro i adrenalin. Cena u partnera se nemění.</p>
				<div class="hl">
					<form action="/" method="get" role="search">
						<label class="sr" for="q2">Co hledáte?</label>
						<input id="q2" type="search" name="s" placeholder="Např. wellness pro dva, masáž v Brně…" autocomplete="off" data-suggest />
						<input type="hidden" name="post_type" value="product" />
						<button type="submit">Hledat</button>
					</form>
					<div class="hl__s" role="listbox" hidden></div>
				</div>
				<ul class="chips">
					{[['romanticke-pobyty', 'Romantika'], ['wellness-dovolena', 'Wellness'], ['adrenalinove-zazitky', 'Adrenalin'], ['pobyty-a-ubytovani', 'Pobyty'], ['masaze', 'Masáže']].map(([s, l]) => <li><a class="chip" href={`/${s}/`}>{l}</a></li>)}
				</ul>
				<ul class="cisla"><li><b>{cislo(v.total)}</b> aktuálních nabídek</li><li><b>3</b> prověření partneři</li><li><b>denně</b> nové slevy</li></ul>
			</div>
			<img class="hero__img" src="/a/mark-256.webp" alt="" width="256" height="256" />
		</div>
	</section>
	<div class="w">
		<section class="sek">
			<div class="sh"><h2>Procházejte podle kategorií</h2></div>
			<ul class="tiles">{v.sections.map((x, i) => { const im = tileImg(x); return (
				<li><a class={im ? 'tile' : 'tile tile--txt'} href={x.url}>{im && <img src={im.src} srcset={im.srcset} alt="" width="280" height="187" loading={i < 2 ? 'eager' : 'lazy'} />}<span>{x.name}{x.count > 0 && <small>{cislo(x.count)} nabídek</small>}</span></a></li>
			); })}</ul>
		</section>
		{v.top.length > 0 && (
			<section class="sek">
				<div class="sh"><h2>Nejoblíbenější nabídky</h2><a href="/slevy/">Všechny slevy →</a></div>
				<Mrizka items={v.top} t={v.tree} eager={false} />
			</section>
		)}
		<section class="sek">
			<div class="sh"><h2>Nejoblíbenější místa a dovolená</h2><a href="/cestovani/">Celé cestování →</a></div>
			<ul class="tiles">{v.places.map((x) => { const im = tileImg(x); return (
				<li><a class={im ? 'tile' : 'tile tile--txt'} href={x.url}>{im && <img src={im.src} srcset={im.srcset} alt="" width="280" height="187" loading="lazy" />}<span>{x.name}{x.count > 0 && <small>{cislo(x.count)} nabídek</small>}</span></a></li>
			); })}</ul>
		</section>
		{v.cities.length > 0 && (
			<section class="sek">
				<div class="sh"><h2>Zážitky a pobyty ve vašem městě</h2></div>
				<ul class="chips">{v.cities.map((c) => <li><a class="chip" href={`/lokalita/${c.slug}/`}>{c.name} <span>{c.count}</span></a></li>)}</ul>
			</section>
		)}
		<section class="sek">
			<div class="sh"><h2>Proč Kouzelný děda</h2></div>
			<ul class="proc">
				<li><b>Všechny slevy na jednom místě</b><span>Nabídky Slevomatu, Zážitky.cz a Adropu porovnáte bez otevírání desítek oken.</span></li>
				<li><b>Ověření partneři</b><span>Nakupujete přímo u partnera v jeho zabezpečeném prostředí, s jeho zárukami.</span></li>
				<li><b>Cena se nemění</b><span>Za proklik nic neplatíte — cena je stejná, jako kdybyste šli k partnerovi napřímo.</span></li>
				<li><b>Čerstvé nabídky</b><span>Katalog obnovujeme několikrát denně, skončené nabídky hned schováváme.</span></li>
			</ul>
		</section>
		{v.posts.length > 0 && (
			<section class="sek">
				<div class="sh"><h2>Tipy z blogu</h2><a href="/blog/">Všechny články →</a></div>
				<ul class="posts">{v.posts.map((p) => (
					<li><article class="pk">
						<div class="pk__i">{(p.image_card || p.image) && <img src={p.image_card || p.image} alt="" loading="lazy" width="400" height="225" />}</div>
						<div class="pk__b"><time>{datum(p.published_at)}</time><h3><a href={`/${p.slug}/`}>{decode(p.title)}</a></h3><p>{excerpt(p.excerpt, 140)}</p></div>
					</article></li>
				))}</ul>
			</section>
		)}
		<section class="sek txt">
			<h2>Zážitky, pobyty a dovolená se slevou</h2>
			<p>Kouzelný děda je vyhledávač zvýhodněných nabídek na pobyty, dovolenou a zážitky. Najdete tu wellness víkendy pro dva, glamping, chaty a chalupy, last minute pobyty, masáže a péči o krásu, gastronomické zážitky i adrenalin. Nabídky přebíráme přímo od partnerů a obnovujeme je několikrát denně, takže vidíte aktuální ceny i výši slevy. Po kliknutí přejdete k partnerovi, kde nákup dokončíte — cena pro vás zůstává stejná.</p>
		</section>
	</div>
</Base>
