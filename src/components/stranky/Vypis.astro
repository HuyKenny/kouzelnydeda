---
// Listing (section, category, category × city, city, partner, gift landing): header band with the icon, H1, intro and
// trust line; subcategory chips grouped like the tree; toolbar (sort, budget, partner); grid; pagination; then the
// texts for search engines (intro, related, FAQ) and gift ideas of the section.
import Base from '../../layouts/Base.astro';
import Drobky from '../Drobky.astro';
import Mrizka from '../Mrizka.astro';
import Strankovani from '../Strankovani.astro';
import Ik from '../Ik.astro';
import { SORTS, toQuery } from '../../lib/filters';
import { card } from '../../lib/img';
import type { ListingView } from '../../lib/views';

interface Props { v: ListingView }
const { v } = Astro.props;
const first = v.page === 1 && !v.filtered;
const stores = [...v.tree.stores.values()].filter((s) => s.count > 0);
const lcp = v.items[0] ? card(v.items[0].image, 360) : null;
const iconName = v.icon;
const groups = new Map<string, typeof v.subcats>();
for (const c of v.subcats) (groups.get(c.grp ?? '') ?? groups.set(c.grp ?? '', []).get(c.grp ?? '')!).push(c);
const BUDGET: Array<[number | undefined, string]> = [[undefined, 'Jakákoli cena'], [500, 'do 500 Kč'], [1000, 'do 1 000 Kč'], [2000, 'do 2 000 Kč'], [5000, 'do 5 000 Kč']];
const budgetUrl = (max: number | undefined) => v.base + toQuery({ ...v.f, max, min: undefined });
---
<Base meta={v.meta} pageType={v.pageType} preloadImg={lcp}>
	<div class="w">
		<Drobky items={v.crumbs} />
		<header class="vh">
			{v.ill ? <div class="vh__ik vh__ik--il"><img src={`/a/il/${v.ill}.webp`} alt="" width="120" height="120" /></div> : iconName && <div class="vh__ik"><Ik n={iconName || 'darek'} /></div>}
			<div>
				<h1>{v.h1}</h1>
				{v.trust ? <p class="trust"><span><b>{v.trust}</b></span><span><Ik n="check" />ověřené slevy</span><span><Ik n="check" />voucher hned e-mailem</span></p>
					: <p class="trust"><span><b>{v.total.toLocaleString('cs-CZ')} nabídek</b></span><span><Ik n="check" />ověření partneři</span><span><Ik n="check" />voucher hned e-mailem</span><span><Ik n="check" />cena se nemění</span></p>}
				{v.descriptionHtml && first && <div class="lead txt" set:html={v.descriptionHtml} />}
			</div>
		</header>
		{first && v.subcats.length > 0 && (
			<nav class="subs" aria-label="Podkategorie">
				{[...groups.entries()].map(([g, list]) => (
					<div class="subs__g">
						{g && <h2>{g}</h2>}
						<ul class="chips">{list.map((c) => <li><a class="chip" href={c.url}>{c.icon && <Ik n={c.icon} />}{c.name}{c.count ? <span>{c.count.toLocaleString('cs-CZ')}</span> : null}</a></li>)}</ul>
					</div>
				))}
			</nav>
		)}
		{v.chips.length > 0 && (
			<ul class="chips"><li class="chips__l">{v.chipsTitle}:</li>{v.chips.map((c) => <li><a class="chip" href={c.url} aria-current={c.active ? 'page' : undefined}>{c.icon && <Ik n={c.icon} />}{c.name}{c.count ? <span>{c.count}</span> : null}</a></li>)}</ul>
		)}
		<form class="tb" action={v.base} method="get">
			<h2>{v.h2 || `${v.total.toLocaleString('cs-CZ')} nabídek`}</h2>
			<div class="rozp" role="list" aria-label="Rozpočet">{BUDGET.map(([m, l]) => <a role="listitem" href={budgetUrl(m)} rel={m ? 'nofollow' : undefined} aria-current={v.f.max === m && !v.f.min ? 'page' : undefined}>{l}</a>)}</div>
			<div class="tb__f">
				<label class="sr" for="orderby">Řazení</label>
				<select id="orderby" name="orderby">{SORTS.map(([k, l]) => <option value={k} selected={v.f.sort === k}>{l}</option>)}</select>
				{v.pageType !== 'store' && stores.length > 1 && (
					<><label class="sr" for="partner">Partner</label>
					<select id="partner" name="partner"><option value="">Všichni partneři</option>{stores.map((s) => <option value={s.slug} selected={v.f.partner === s.slug}>{s.name}</option>)}</select></>
				)}
				{v.f.max !== undefined && <input type="hidden" name="max_price" value={v.f.max} />}
				<noscript><button type="submit">Použít</button></noscript>
			</div>
		</form>
		{v.items.length ? <Mrizka items={v.items} t={v.tree} ctx={v.pageType} /> : <p class="prazdne">Teď tu nejsou žádné nabídky. Zkuste jiný rozpočet nebo <a href="/">úvodní stránku</a>.</p>}
		<Strankovani base={v.base} page={v.page} pages={v.pages} query={v.qs} />
		{first && v.gifts.length > 0 && (
			<section class="sek">
				<div class="sh"><h2>Hledáte dárek?</h2><a href="/zazitkove-darky/">Všechny tipy →</a></div>
				<ul class="darky">{v.gifts.map((g) => <li><a href={`/${g.slug}/`}>{g.il ? <img src={`/a/il/${g.il}.webp`} alt="" width="72" height="72" loading="lazy" /> : <Ik n={g.icon} />}{g.h1.split(':')[0]}</a></li>)}</ul>
			</section>
		)}
		{v.intro && (
			<section class="sek txt">
				{v.introTitle && <h2>{v.introTitle}</h2>}
				<p>{v.intro}</p>
			</section>
		)}
		{v.related.length > 0 && (
			<section class="sek">
				<h2>Mohlo by se hodit</h2>
				<ul class="chips">{v.related.map((c) => <li><a class="chip" href={c.url}>{c.icon && <Ik n={c.icon} />}{c.name} <span>{c.count}</span></a></li>)}</ul>
			</section>
		)}
		{v.faq.length > 0 && (
			<section class="sek faq">
				<h2>Časté dotazy</h2>
				{v.faq.map((f) => <details><summary>{f.q}</summary><div>{f.a}</div></details>)}
			</section>
		)}
	</div>
</Base>
