---
// Footer: sections, gifts, popular cities, information, affiliate disclosure, operator.
import { OPERATOR } from '../lib/site';
import { TOP_GIFTS } from '../lib/views';
const year = new Date().getFullYear();
const CITIES: Array<[string, string]> = [['praha', 'Praha'], ['brno', 'Brno'], ['ostrava', 'Ostrava'], ['plzen', 'Plzeň'], ['ceske-budejovice', 'České Budějovice'], ['hradec-kralove', 'Hradec Králové'],
	['olomouc', 'Olomouc'], ['liberec', 'Liberec']];
const PERSONAL: Array<[string, string]> = [['darek-pro-maminku', 'Dárek pro maminku'], ['darek-pro-tatu', 'Dárek pro tátu'], ['darek-pro-babicku', 'Dárek pro babičku'], ['darek-pro-dedu', 'Dárek pro dědu'], ['darek-pro-dceru', 'Dárek pro dceru'], ['darek-pro-syna', 'Dárek pro syna'], ['darek-pro-sestru', 'Dárek pro sestru'], ['darek-pro-bratra', 'Dárek pro bratra'], ['darek-pro-kamaradku', 'Dárek pro kamarádku'], ['darek-pro-kamarada', 'Dárek pro kamaráda'], ['darek-pro-pritelkyni', 'Dárek pro přítelkyni'], ['darek-pro-pritele', 'Dárek pro přítele'], ['darek-pro-manzela', 'Dárek pro manžela'], ['darek-pro-manzelku', 'Dárek pro manželku'], ['darek-pro-kolegu', 'Dárek pro kolegu'], ['darek-pro-sefa', 'Dárek pro šéfa'], ['darek-pro-seniory', 'Dárek pro seniory'], ['darek-pro-teenagera', 'Dárek pro teenagera'], ['darek-k-narozeninam', 'Dárek k narozeninám'], ['vanocni-darek', 'Vánoční dárek'], ['darky-do-500-kc', 'Dárky do 500 Kč'], ['darky-do-1000-kc', 'Dárky do 1000 Kč'], ['darky-do-2000-kc', 'Dárky do 2000 Kč']];
const WISHES: Array<[string, string]> = [['prani-k-narozeninam', 'Přání k narozeninám'], ['prani-k-svatku', 'Přání k svátku'], ['vanocni-prani-texty', 'Vánoční přání'], ['novorocni-prani', 'Novoroční přání'], ['prani-k-vyroci-svatby', 'Přání k výročí svatby'], ['prani-ke-dni-matek', 'Přání ke Dni matek']];
const TRIPS: Array<[string, string]> = [['kam-na-vylet-s-detmi', 'Kam na výlet s dětmi'], ['kam-na-vylet-v-praze', 'Praha'], ['kam-na-vylet-v-okoli-prahy', 'Okolí Prahy'], ['kam-na-vylet-stredocesky-kraj', 'Středočeský kraj'], ['kam-na-vylet-jihocesky-kraj', 'Jihočeský kraj'], ['kam-na-vylet-plzensky-kraj', 'Plzeňský kraj'], ['kam-na-vylet-karlovarsky-kraj', 'Karlovarský kraj'], ['kam-na-vylet-ustecky-kraj', 'Ústecký kraj'], ['kam-na-vylet-liberecky-kraj', 'Liberecký kraj'], ['kam-na-vylet-kralovehradecky-kraj', 'Královéhradecký kraj'], ['kam-na-vylet-pardubicky-kraj', 'Pardubický kraj'], ['kam-na-vylet-vysocina', 'Vysočina'], ['kam-na-vylet-jihomoravsky-kraj', 'Jihomoravský kraj'], ['kam-na-vylet-olomoucky-kraj', 'Olomoucký kraj'], ['kam-na-vylet-zlinsky-kraj', 'Zlínský kraj'], ['kam-na-vylet-moravskoslezsky-kraj', 'Moravskoslezský kraj'], ['kam-na-dovolenou', 'Kam na dovolenou']];
---
<footer class="ft">
	<div class="w ft__in">
		<div>
			<a class="ft__logo" href="/"><img src="/a/logo-264.webp" alt="Kouzelný děda" width="140" height="46" loading="lazy" /></a>
			<p>Zážitky, pobyty a wellness na jednom místě. Darujte zážitek místo věcí — voucher vám partner pošle hned e-mailem.</p>
		</div>
		<div><h2>Kategorie</h2><ul>
			<li><a href="/pobyty/">Pobyty a dovolená</a></li><li><a href="/zazitky/">Zážitky</a></li><li><a href="/wellness-a-krasa/">Wellness a krása</a></li>
			<li><a href="/jidlo-a-piti/">Jídlo a pití</a></li><li><a href="/kurzy/">Kurzy a workshopy</a></li><li><a href="/wellness-pobyty/">Wellness pobyty</a></li><li><a href="/glamping/">Glamping</a></li>
		</ul></div>
		<div><h2>Dárky</h2><ul>{TOP_GIFTS.slice(0, 8).map((g) => <li><a href={`/${g.slug}/`}>{g.h1.split(':')[0]}</a></li>)}</ul></div>
		<div><h2>Města</h2><ul>{CITIES.map(([s, n]) => <li><a href={`/lokalita/${s}/`}>{n}</a></li>)}</ul></div>
		<div><h2>Informace</h2><ul>
			<li><a href="/o-nas/">O nás</a></li><li><a href="/blog/">Blog</a></li><li><a href="/podminky-pouziti/">Podmínky použití</a></li>
			<li><a href="/ochrana-osobnich-udaju/">Ochrana osobních údajů</a></li><li><a href="/prohlaseni-o-pouzivani-cookies/">Cookies</a></li>
			<li><a href="#" data-kd-consent-open>Nastavení cookies</a></li>
		</ul></div>
	</div>
	<div class="w ft__more">
		<h2>Dárky pro koho</h2>
		<ul class="ft__tags">{PERSONAL.map(([s, n]) => <li><a href={`/${s}/`}>{n}</a></li>)}</ul>
		<h2>Kam na výlet</h2>
		<ul class="ft__tags">{TRIPS.map(([s, n]) => <li><a href={`/${s}/`}>{n}</a></li>)}</ul>
		<h2>Přání a nápady</h2>
		<ul class="ft__tags">{WISHES.map(([s, n]) => <li><a href={`/${s}/`}>{n}</a></li>)}</ul>
	</div>
	<div class="w ft__pozn">
		<p>Kouzelný děda je rozcestník nabídek. Za nákup přes odkaz na partnera můžeme dostat provizi — cena pro vás zůstává stejná. Nabídky, ceny a jejich platnost určuje partner.</p>
		<p>© {year} Kouzelný děda · provozovatel {OPERATOR.name}, IČO {OPERATOR.ico}, DS {OPERATOR.ds}, {OPERATOR.street}, {OPERATOR.zip} {OPERATOR.city}</p>
	</div>
</footer>
